# Copy this file to .env.local for local development.
# On Vercel, set these in Project Settings → Environment Variables.

# ---- Admin editor (/admin) ----
# Password used to sign in at /admin
ADMIN_PASSWORD=change-me

# ---- Supabase (site content storage) ----
# Create a free project at https://supabase.com, then run this in its SQL editor:
#   create table if not exists site_content (
#     id text primary key default 'site',
#     data jsonb not null,
#     updated_at timestamptz not null default now()
#   );
SUPABASE_URL=https://your-project.supabase.co
# Dashboard → Project Settings → API → service_role key (server-side only!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Contact form (EmailJS) ----
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
